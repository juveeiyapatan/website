trigger:
  branches:
    include:
      - main # Trigger the pipeline on changes to the main branch

pool:
  vmImage: 'ubuntu-latest' # Use the latest Ubuntu virtual machine

variables:
  javaHome: '/usr/lib/jvm/java-11-openjdk-amd64' # Specify the Java version
  artifactName: 'java-app-build'

stages:
  - stage: Build
    displayName: 'Build Stage'
    jobs:
      - job: Build
        displayName: 'Build the Java application'
        steps:
          - task: UseJava@1
            inputs:
              version: '11' # Specify the Java version
              distribution: 'Zulu'
          
          - script: |
              echo "Building the application..."
              ./mvnw clean package # Adjust based on your build tool (Maven or Gradle)
            displayName: 'Run Maven Build'
          
          - task: PublishBuildArtifacts@1
            inputs:
              pathToPublish: '$(System.DefaultWorkingDirectory)/target/*.jar' # Path to your build artifacts
              artifactName: 'java-app-build'
              publishLocation: 'Container'

  - stage: Deploy
    displayName: 'Deploy Stage'
    dependsOn: Build
    jobs:
      - deployment: Deploy
        displayName: 'Deploy to Azure App Service'
        environment: 'production' # Replace with your environment name
        strategy:
          runOnce:
            deploy:
              steps:
                - task: AzureWebApp@1
                  inputs:
                    azureSubscription: '<Your Azure Subscription>'
                    appType: 'webApp' # or use 'webAppLinux' for Linux-based App Services
                    appName: '<Your App Service Name>'
                    package: '$(Pipeline.Workspace)/java-app-build/*.jar'
